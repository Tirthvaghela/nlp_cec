# Classroom pilot configuration TEMPLATE (docs/PILOT_RUNBOOK.md). Copy to backend/.env on the pilot machine
# only after deployment has been authorised. Never commit the filled-in file. Fill every <...> value.

ENVIRONMENT=production
PILOT_MODE=true
REQUIRE_REVIEW_BEFORE_PUBLISH=true

MONGODB_URI=mongodb://localhost:27017
# A NEW, EMPTY database used only for the pilot - not "answerwise" (development/demo data). Initialise it once with
# python -m scripts.pilot_init_db (writes the pilot marker; the server refuses an unmarked database). Never seed it.
MONGODB_DB=<pilot database name, e.g. answerwise_pilot_2027s1>

# python -c "import secrets; print(secrets.token_urlsafe(48))"   (PILOT_MODE/production refuse weak or placeholder values)
JWT_SECRET=<long random value>
JWT_EXPIRE_MINUTES=480
# IT-approved frontend origin(s), each https://host[:port] - no path, no wildcard, no http (refused in PILOT_MODE).
CORS_ORIGINS=<exact https frontend origin(s), comma-separated>
# Supported pilot topology: browsers reach the API server directly (no reverse proxy) - leave EMPTY, and start the
# server with python -m scripts.run_server (it then ignores X-Forwarded-For). Only if faculty/IT approve a reverse
# proxy: its exact IP address(es). Never *, never a loopback address (refused in PILOT_MODE).
TRUSTED_PROXIES=
# Who terminates TLS: false (default) = this server, via run_server --ssl-certfile/--ssl-keyfile (IT-issued).
# true = the IT-approved proxy in TRUSTED_PROXIES does (an explicit statement IT must confirm in writing).
TLS_TERMINATED_BY_PROXY=false
# Shared only with the participating teachers, so students cannot register as teachers. At least 16 characters,
# random, no common words:  python -c "import secrets; print(secrets.token_urlsafe(18))"
TEACHER_INVITE_CODE=<random code>

SIMILARITY_BACKEND=embedding
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Required in PILOT_MODE: the model loads at start-up so the preflight can confirm it before any evaluation.
PRELOAD_MODEL=true
LOG_LEVEL=INFO
