# Copy to backend/.env and adjust. Never commit the real .env file.

ENVIRONMENT=development

# MongoDB connection
MONGODB_URI=mongodb://localhost:27017
# Local development database. Never "answerwise": that is the protected main database (incident of 2026-10-17,
# docs/SPRINT9_INCIDENT_CONTAINMENT.md) and every app process now refuses to start with it.
MONGODB_DB=answerwise_dev

# JWT signing secret - REQUIRED. Use a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left empty in development, a random secret is generated at start-up
# (everyone is logged out when the server restarts). Mandatory in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: if set, registering as a teacher requires this invite code.
# Leave empty to allow open teacher registration (local development only).
TEACHER_INVITE_CODE=

# NLP: auto (embedding model, falls back to TF-IDF if it cannot load) | embedding | tfidf
SIMILARITY_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Load the model in the background at start-up so the first evaluation is fast
PRELOAD_MODEL=true
# Classroom pilot: set to true so results can only be published after the teacher reviewed every question.
REQUIRE_REVIEW_BEFORE_PUBLISH=false
# Classroom pilot fail-safe: refuse to start unless the pilot configuration is safe (see .env.pilot.example).
PILOT_MODE=false

LOG_LEVEL=INFO

# Optional: reference-answer and rubric drafting through Groq (https://console.groq.com/keys).
# Backend only - never put this key in frontend/.env and never commit the real value. Leave empty to disable drafting:
# teachers then write reference answers themselves and rubrics are derived locally. Restart the backend after changing.
GROQ_API_KEY=your_groq_api_key_here
# Groq chat model id (https://console.groq.com/docs/models). Model access and rate limits depend on your Groq plan.
GENERATION_MODEL=llama-3.3-70b-versatile
